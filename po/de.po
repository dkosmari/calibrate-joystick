#: ../ui/device-page.glade.h:7
msgid "Match device name"
msgstr "Gerätenamen abgleichen"

#: ../ui/device-page.glade.h:8
msgid "Match device's name when saving or loading calibration."
msgstr ""
"Passen Sie den Gerätenamen beim Speichern oder Laden der Kalibrierung an."

#: ../ui/device-page.glade.h:9
msgid "Match device vendor ID"
msgstr "Gerätehersteller-ID abgleichen"

#: ../ui/device-page.glade.h:10
msgid "Match device's vendor ID when saving or loading calibration."
msgstr ""
"Passen Sie die Hersteller-ID des Geräts beim Speichern oder Laden der "
"Kalibrierung an."

#: ../ui/device-page.glade.h:11
msgid "Match device product ID"
msgstr "Produkt-ID des Geräts abgleichen"

#: ../ui/device-page.glade.h:12
msgid "Match device's product ID when saving or loading calibration."
msgstr ""
"Passen Sie die Produkt-ID des Geräts beim Speichern oder Laden der "
"Kalibrierung an."

#: ../ui/device-page.glade.h:13
msgid "Match device version number"
msgstr "Geräteversionsnummer abgleichen"

#: ../ui/device-page.glade.h:14
msgid "Match device's version number when saving or loading calibration."
msgstr ""
"Passen Sie die Versionsnummer des Geräts beim Speichern oder Laden der "
"Kalibrierung an."

#: ../ui/device-page.glade.h:15
msgid "Save the calibration parameters to a file."
msgstr "Speichern Sie die Kalibrierungsparameter in einer Datei."

#: ../ui/device-page.glade.h:16
msgid "_Save"
msgstr "_Speichern"

#: ../ui/device-page.glade.h:17
msgid "Delete the calibration file."
msgstr "Löschen Sie die Kalibrierungsdatei."

#: ../ui/device-page.glade.h:19
msgid "Revert the user interface back to the current device parameters."
msgstr ""
"Setzen Sie die Benutzeroberfläche auf die aktuellen Geräteparameter zurück."

#: ../ui/device-page.glade.h:20
msgid "_Revert"
msgstr "_Zurücksetzen"

#: ../ui/device-page.glade.h:21
msgid "Apply all calibration parameters to the device."
msgstr "Wenden Sie alle Kalibrierungsparameter auf das Gerät an."

#: ../ui/device-page.glade.h:22
msgid "_Apply"
msgstr "_Anwenden"

